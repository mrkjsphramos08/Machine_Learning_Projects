# Python virtual environment
.venv/
venv/
ENV/
env/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# MLflow tracking store & artifacts (local runs store metrics, params, and serialized models here)
mlruns/
.trash/
*.db

# Data directories (keep directory structure and DVC metadata, ignore untracked data files)
data/raw/*
!data/raw/.gitkeep
!data/raw/.gitignore
!data/raw/*.dvc
data/processed/*
!data/processed/.gitkeep
!data/processed/.gitignore
!data/processed/*.dvc

# Trained models and serialized artifacts (tracked via MLflow or Model Registry, not Git)
models/*
!models/.gitkeep
!models/.gitignore
!models/*.dvc

# OS generated files
Thumbs.db
.DS_Store
