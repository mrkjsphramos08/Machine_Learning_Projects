# Python virtual environment
.venv/
venv/
ENV/
env/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Linter and type-checker caches (ruff self-ignores, but be explicit)
.ruff_cache/
.pyrefly_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# MLflow tracking store & artifacts (local runs store metrics, params, and serialized models here)
mlruns/
.trash/
*.db

# ---------------------------------------------------------------------------
# Per-project data and artifacts (projects/*/...). Directory structure, DVC
# pointer files and lock files stay in Git; the heavy data files do not.
# ---------------------------------------------------------------------------

# Raw, immutable source data
projects/*/data/raw/*
!projects/*/data/raw/.gitkeep
!projects/*/data/raw/*.dvc

# Processed intermediates produced by the `prepare` pipeline stage
projects/*/data/processed/*
!projects/*/data/processed/.gitkeep
!projects/*/data/processed/*.dvc

# Trained models (tracked via MLflow / the Model Registry, or DVC — never Git)
projects/*/models/*
!projects/*/models/.gitkeep
!projects/*/models/*.dvc

# Notebook checkpoint/test output folders
projects/*/notebooks/.ipynb_checkpoints/
projects/*/reports/

# OS generated files
Thumbs.db
.DS_Store
